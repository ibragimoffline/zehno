{
  "name": "zehno",
  "private": true,
  "version": "0.1.0",
  "description": "Zehno.uz — onlayn ta'lim marketplace platformasi (monorepo)",
  "scripts": {
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f api web worker",
    "restart:api": "docker compose restart api worker beat",
    "peertube:up": "docker compose -f docker-compose.peertube.yml up -d",
    "peertube:down": "docker compose -f docker-compose.peertube.yml down",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:typecheck": "npm --prefix apps/web run typecheck",
    "web:lint": "npm --prefix apps/web run lint",
    "api:lint": "docker compose exec api ruff check app",
    "api:test": "docker compose exec api pytest -v",
    "api:migrate": "docker compose exec api alembic upgrade head",
    "api:seed": "docker compose exec api python -m app.cli seed",
    "api:shell": "docker compose exec api bash",
    "scan:secrets": "sh scripts/scan-secrets.sh",
    "hooks:install": "git config core.hooksPath .githooks"
  }
}
