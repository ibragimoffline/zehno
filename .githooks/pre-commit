#!/bin/sh
#
# Zehno.uz - sirlarni commit qilishdan himoya qiluvchi hook.
#
# O'rnatish (har bir dasturchi bir marta):
#     git config core.hooksPath .githooks
#
# Tekshiruv mantiqi scripts/scan-secrets.sh da (u alohida ham ishlatiladi).
# Barcha xabarlar stderr'ga yoziladi va SIGPIPE e'tiborsiz qoldiriladi -
# `git commit | head` kabi quvurlar tekshiruvni chetlab o'ta olmaydi.
#
# Xato aniqlash bo'lsa:  ALLOW_SECRET=1 git commit ...

trap '' PIPE 2>/dev/null || true

ROOT=$(git rev-parse --show-toplevel 2>/dev/null || echo ".")
SCANNER="$ROOT/scripts/scan-secrets.sh"

if [ ! -f "$SCANNER" ]; then
    echo >&2 "OGOHLANTIRISH: scripts/scan-secrets.sh topilmadi - sir tekshiruvi o'tkazilmadi"
    exit 0
fi

sh "$SCANNER" --staged
status=$?

if [ "$status" -eq 0 ]; then
    exit 0
fi

if [ "${ALLOW_SECRET:-}" = "1" ]; then
    echo >&2 "ALLOW_SECRET=1 - tekshiruv ataylab chetlab o'tildi"
    echo >&2 ""
    exit 0
fi

echo >&2 "Xato aniqlash bo'lsa:  ALLOW_SECRET=1 git commit ..."
echo >&2 ""
exit 1
