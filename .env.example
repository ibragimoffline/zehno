#######################################################################
# Zehno.uz — muhit o'zgaruvchilari namunasi
# Nusxa oling:  cp .env.example .env   (Windows: copy .env.example .env)
#######################################################################

# ---------------------------------------------------------------------
# Umumiy
# ---------------------------------------------------------------------
APP_NAME=Zehno
APP_ENV=development                 # development | staging | production
DEBUG=true
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_WEB_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=zehno
POSTGRES_USER=zehno
POSTGRES_PASSWORD=zehno_dev_password
# To'liq DSN (bo'sh qoldirsangiz yuqoridagilardan yig'iladi)
DATABASE_URL=

# ---------------------------------------------------------------------
# Redis (cache + Celery broker/backend)
# ---------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ---------------------------------------------------------------------
# Auth / JWT (python-jose)
# ---------------------------------------------------------------------
# Production'da albatta almashtiring:  openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_HASH_SCHEME=argon2            # argon2 | bcrypt
REFRESH_COOKIE_NAME=zehno_refresh
REFRESH_COOKIE_SECURE=false            # production'da true (HTTPS)
REFRESH_COOKIE_DOMAIN=

# Birinchi super-admin (migratsiyadan keyin seed orqali yaratiladi)
FIRST_SUPERADMIN_EMAIL=admin@zehno.uz
FIRST_SUPERADMIN_PASSWORD=Admin12345!

# ---------------------------------------------------------------------
# Object storage (MinIO / S3-compatible)
# ---------------------------------------------------------------------
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=zehno_minio
S3_SECRET_KEY=zehno_minio_password
S3_BUCKET=zehno
S3_REGION=us-east-1
S3_USE_SSL=false

# ---------------------------------------------------------------------
# Video provayder (adapter pattern — bo'lim 6.1)
# ---------------------------------------------------------------------
VIDEO_PROVIDER=mock                    # mock | peertube | kinescope | bunny
VIDEO_SIGNED_URL_TTL_MINUTES=15

# PeerTube (MVP uchun asosiy tanlov, self-hosted)
PEERTUBE_BASE_URL=http://peertube:9000
PEERTUBE_PUBLIC_URL=http://localhost:9010
PEERTUBE_USERNAME=
PEERTUBE_PASSWORD=
PEERTUBE_CHANNEL_ID=

# Kinescope (masshtablanish bosqichi)
KINESCOPE_API_KEY=
KINESCOPE_PROJECT_ID=

# Bunny Stream
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
BUNNY_STREAM_TOKEN_KEY=

# ---------------------------------------------------------------------
# PeerTube konteyneri (docker-compose.peertube.yml uchun)
# ---------------------------------------------------------------------
# Majburiy. Yangi qiymat: openssl rand -hex 32
PEERTUBE_SECRET=
PEERTUBE_DB_PASSWORD=peertube_dev_password
PEERTUBE_ADMIN_EMAIL=admin@zehno.uz
PEERTUBE_HOSTNAME=localhost

# ---------------------------------------------------------------------
# To'lov provayderlari
# ---------------------------------------------------------------------
PAYMENT_PROVIDER=mock                  # mock | payme | click
PAYMENT_SANDBOX=true
PLATFORM_COMMISSION_PERCENT=15

# Payme (Merchant API)
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# Click (Merchant API)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
CLICK_CHECKOUT_URL=https://my.click.uz/services/pay

# ---------------------------------------------------------------------
# CRM provayder (B2B)
# ---------------------------------------------------------------------
CRM_PROVIDER=mock                      # mock | bitrix24 | espocrm
BITRIX24_WEBHOOK_URL=                  # https://<portal>.bitrix24.ru/rest/1/<token>/
ESPOCRM_BASE_URL=
ESPOCRM_API_KEY=

# ---------------------------------------------------------------------
# Telegram bot (bildirishnomalar)
# ---------------------------------------------------------------------
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# ---------------------------------------------------------------------
# Email (SMTP — ixtiyoriy)
# ---------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Zehno <no-reply@zehno.uz>

# ---------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=10/minute

# ---------------------------------------------------------------------
# Frontend (apps/web) — Next.js public o'zgaruvchilari
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Zehno.uz
